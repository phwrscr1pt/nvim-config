[HKEY_CURRENT_USER\Software\Classes\Unknown\shell\open\command]
@="\"C:\\Program Files\\Neovide\\neovide.exe\" \"%1\""

; --- 6. Right-click "Open with Neovide" on every file ---
[HKEY_CURRENT_USER\Software\Classes\*\shell\NeovideOpen]
@="Open with Neovide"
"Icon"="C:\\Program Files\\Neovide\\neovide.exe,0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\NeovideOpen\command]
@="\"C:\\Program Files\\Neovide\\neovide.exe\" \"%1\""

; --- 7. Register in Settings > Default apps ---
[HKEY_CURRENT_USER\Software\Neovide\Capabilities]
"ApplicationName"="Neovide"
"ApplicationDescription"="No Nonsense Neovim GUI"

